---
export interface Props {
  title: string;
  description: string;
  datePublished?: Date;
  dateModified?: Date;
  path: string;
  faqs?: { q: string; a: string }[];
  articleSchema?: boolean;
  ogImage?: string;
}

const {
  title,
  description,
  datePublished,
  dateModified,
  path,
  faqs = [],
  articleSchema = false,
  ogImage = '/images/og-default.png',
} = Astro.props;

const siteUrl = 'https://site.marketing';
const canonical = new URL(path, siteUrl).toString();
const ogImageAbsoluteUrl = new URL(ogImage, siteUrl).toString();

const PERSON_ID = 'https://site.marketing/#sunny-patel';
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': PERSON_ID,
  name: 'Sunny Patel',
  url: siteUrl,
  jobTitle: 'SEO Consultant',
  description: '14 years in SEO, specialising in topical authority and entity SEO.',
  knowsAbout: ['SEO', 'Generative Engine Optimization', 'Topical Authority', 'Entity SEO', 'Conversion Rate Optimization'],
  sameAs: ['https://www.linkedin.com/in/sunny-patel-seo/'],
};

const articleJsonLd = articleSchema
  ? {
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: title,
      description,
      author: { '@id': PERSON_ID },
      publisher: { '@id': PERSON_ID },
      image: [ogImageAbsoluteUrl],
      datePublished: datePublished?.toISOString(),
      dateModified: dateModified?.toISOString(),
      mainEntityOfPage: canonical,
    }
  : null;

const HUBS: Record<string, string> = {
  strategy: 'Website Marketing Strategy',
  visibility: 'Search Visibility',
  glossary: 'Glossary',
};

let breadcrumbSchema: Record<string, unknown> | null = null;
if (path !== '/' && path !== '/404/') {
  const segments = path.split('/').filter(Boolean);
  const items: Record<string, unknown>[] = [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}/` },
  ];
  const first = segments[0];
  if (segments.length > 1 && first in HUBS) {
    items.push({
      '@type': 'ListItem',
      position: items.length + 1,
      name: HUBS[first],
      item: `${siteUrl}/${first}/`,
    });
  }
  items.push({ '@type': 'ListItem', position: items.length + 1, name: title });
  breadcrumbSchema = {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: items,
  };
}

const organizationSchema =
  path === '/'
    ? {
        '@context': 'https://schema.org',
        '@type': 'Organization',
        '@id': 'https://site.marketing/#organization',
        name: 'site.marketing',
        url: 'https://site.marketing/',
        logo: 'https://site.marketing/favicon.svg',
        image: ogImageAbsoluteUrl,
        founder: { '@id': PERSON_ID },
      }
    : null;

const faqSchema =
  faqs.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faqs.map((f) => ({
          '@type': 'Question',
          name: f.q,
          acceptedAnswer: { '@type': 'Answer', text: f.a },
        })),
      }
    : null;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={articleSchema ? 'article' : 'website'} />
    <meta property="og:site_name" content="site.marketing" />
    <meta property="og:image" content={ogImageAbsoluteUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="site.marketing — the operator's manual for marketing an existing website." />
    {dateModified && (
      <meta property="article:modified_time" content={dateModified.toISOString()} />
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageAbsoluteUrl} />

    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    {organizationSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    )}
    {breadcrumbSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    )}
    {articleJsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
    )}
    {faqSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    )}

    <style is:global>
      :root {
        --fg: #111;
        --muted: #555;
        --bg: #fff;
        --accent: #007a3d;
        --rule: #eee;
      }
      @media (prefers-color-scheme: dark) {
        :root { --fg: #eee; --muted: #aaa; --bg: #0b0b0b; --accent: #4ee29a; --rule: #222; }
      }
      * { box-sizing: border-box; }
      html { color-scheme: light dark; }
      body {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Inter', system-ui, sans-serif;
        color: var(--fg);
        background: var(--bg);
        margin: 0;
        line-height: 1.65;
      }
      main { max-width: 44rem; margin: 0 auto; padding: 2.5rem 1.25rem 4rem; }
      header.site { max-width: 44rem; margin: 0 auto; padding: 1.5rem 1.25rem 0; }
      header.site a { color: var(--fg); text-decoration: none; font-weight: 600; }
      footer.site { max-width: 44rem; margin: 0 auto; padding: 2rem 1.25rem 3rem; color: var(--muted); font-size: 0.9rem; }
      h1 { font-size: 2.1rem; line-height: 1.2; margin: 1rem 0 1.5rem; }
      h2 { margin-top: 2.5rem; font-size: 1.4rem; }
      h3 { margin-top: 2rem; font-size: 1.1rem; }
      p, ul, ol { font-size: 1.05rem; }
      a { color: var(--accent); }
      hr { border: 0; border-top: 1px solid var(--rule); margin: 2rem 0; }
      code { background: var(--rule); padding: 0.1em 0.35em; border-radius: 4px; font-size: 0.95em; }
      pre { background: var(--rule); padding: 1rem; border-radius: 6px; overflow-x: auto; }
      table { width: 100%; border-collapse: collapse; }
      .table-scroll { overflow-x: auto; margin: 1.25rem 0; }
      th, td { text-align: left; padding: 0.55rem 0.75rem; border-bottom: 1px solid var(--rule); vertical-align: top; }
      th { font-weight: 600; }
      blockquote { border-left: 3px solid var(--accent); margin: 1.5rem 0; padding: 0.25rem 1rem; color: var(--muted); }
      img { max-width: 100%; height: auto; }
      .meta { color: var(--muted); font-size: 0.9rem; margin: -0.5rem 0 2rem; }
    </style>
  </head>
  <body>
    <header class="site">
      <a href="/">site.marketing</a>
    </header>
    <main>
      <slot />
      {articleSchema && dateModified && (
        <p class="meta">Last updated: {dateModified.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}</p>
      )}
    </main>
    <footer class="site">
      <p>site.marketing — the operator's manual for marketing an existing website. Written by <a href="https://www.linkedin.com/in/sunny-patel-seo/">Sunny Patel</a>.</p>
    </footer>
  </body>
</html>

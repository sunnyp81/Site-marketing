---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { clusterPath } from '../../lib/urls';

const entries = (await getCollection('distribution', ({ data }) => !data.draft))
  .sort((a, b) => a.data.title.localeCompare(b.data.title));
---
<BaseLayout
  title="Distribution & Demand — earning off-site mentions"
  description="Everything off-site that compounds on-site: digital PR, email, communities, repurposing and partnerships. Earning the mentions LLMs learn from."
  path="/distribution/"
>
  <h1>Distribution &amp; Demand</h1>
  <p class="meta">Everything off-site that compounds on-site.</p>

  <p>Amplify is the last move, and it's last for a reason. Distribution only works when the site behind it is worth arriving at. Do it in order and the mentions you earn become the sources answer engines quote back to your buyers.</p>

  <h2>Start here</h2>
  <ul>
    <li><a href="/how-to-market-a-website/"><strong>How to Market a Website in 2026: The Existing-Site Playbook</strong></a> — the parent playbook. This section is step 4, amplify.</li>
  </ul>

  <h2>Cluster pages</h2>
  {entries.length === 0 ? (
    <p>Nothing published in this section yet. The <a href="/how-to-market-a-website/">playbook</a> carries the short version until it lands.</p>
  ) : (
    <ul>
      {entries.map((e) => (
        <li>
          <a href={clusterPath('distribution', e)}><strong>{e.data.title}</strong></a>
          <br />
          <span class="meta">{e.data.description}</span>
        </li>
      ))}
    </ul>
  )}
</BaseLayout>

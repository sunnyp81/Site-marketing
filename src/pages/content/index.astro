---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { clusterPath } from '../../lib/urls';

const entries = (await getCollection('contentOps', ({ data }) => !data.draft))
  .sort((a, b) => a.data.title.localeCompare(b.data.title));
---
<BaseLayout
  title="Content Operations — prune, merge, refresh or expand"
  description="Pruning, refreshing, consolidating and expanding a live content inventory. Inventory first, not publish more."
  path="/content/"
>
  <h1>Content Operations</h1>
  <p class="meta">Working the content you already own — before you commission another word of it.</p>

  <p>Some of your pages earn their keep, most are quietly rotting, and a handful carry the entire site. This section is about knowing which is which. I've deleted 400 pages from a site and watched traffic go up; publishing more was never the fix.</p>

  <h2>Start here</h2>
  <ul>
    <li><a href="/how-to-market-a-website/"><strong>How to Market a Website in 2026: The Existing-Site Playbook</strong></a> — the parent playbook. This section is step 3, strengthen.</li>
  </ul>

  <h2>Cluster pages</h2>
  {entries.length === 0 ? (
    <p>Nothing published in this section yet. The <a href="/how-to-market-a-website/">playbook</a> carries the short version until it lands.</p>
  ) : (
    <ul>
      {entries.map((e) => (
        <li>
          <a href={clusterPath('content', e)}><strong>{e.data.title}</strong></a>
          <br />
          <span class="meta">{e.data.description}</span>
        </li>
      ))}
    </ul>
  )}
</BaseLayout>
